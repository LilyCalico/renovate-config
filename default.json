{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Base Renovate config shared by all LilyCalico repositories",
  "extends": [
    "config:recommended",
    ":prConcurrentLimit10",
    ":prHourlyLimitNone"
  ],
  "labels": ["dependencies"],
  "timezone": "Europe/Stockholm",
  "schedule": ["* 9-17 * * 1-5"],
  "minimumReleaseAge": "7 days",
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "packageRules": [
    {
      "description": "Group all patch updates into a single PR",
      "matchUpdateTypes": ["patch"],
      "groupName": "patch updates",
      "groupSlug": "patch"
    },
    {
      "description": "Automerge patch updates once CI passes",
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor / patch updates of type definitions",
      "matchPackageNames": ["@types/**"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge minor / patch updates of linters and formatters",
      "matchPackageNames": [
        "@biomejs/biome",
        "eslint",
        "eslint-*",
        "@eslint/**",
        "prettier",
        "prettier-*"
      ],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ]
}
