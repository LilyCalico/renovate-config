{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Preset for Next.js / React projects",
  "extends": ["local>LilyCalico/renovate-config:default"],
  "packageRules": [
    {
      "description": "Group Next.js packages",
      "matchPackageNames": ["next", "@next/**", "eslint-config-next"],
      "groupName": "Next.js",
      "groupSlug": "nextjs"
    },
    {
      "description": "Group React and its type definitions",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "React",
      "groupSlug": "react"
    },
    {
      "description": "Group Storybook packages",
      "matchPackageNames": ["storybook", "@storybook/**"],
      "groupName": "Storybook",
      "groupSlug": "storybook"
    },
    {
      "description": "Group TanStack packages",
      "matchPackageNames": ["@tanstack/**"],
      "groupName": "TanStack",
      "groupSlug": "tanstack"
    }
  ]
}
